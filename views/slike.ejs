<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galerija</title>

    <link rel="stylesheet" href="/styles/style.css">
    <link rel="stylesheet" href="/styles/style_slike.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>

<body>

<header>
    <h1>Galerija slika</h1>
</header>

<nav aria-label="Glavna navigacija">
    <ul class="nav-menu">
        <li class="dropdown">
            <a href="#"> ☰ Menu</a>
            <ul class="submenu">
                <li><a href="/index_predlozak.html">Početna</a></li>
                <li><a href="/grafikon.html">Grafikoni</a></li>
                <li><a href="/slike">Galerija</a></li>
            </ul>
        </li>
    </ul>
</nav>

<section class="galerija"> 
    <h1>Galerija</h1>

    <% images.forEach(image => { %>
        <figure class="galerija_slika">
            <a href="#<%= image.id %>">
                <img src="<%= image.url %>" alt="<%= image.title %>">
            </a>
            <figcaption><%= image.title %></figcaption>
        </figure>
    <% }); %>

    <% images.forEach(image => { %>
        <div id="<%= image.id %>" class="lightbox">
            <a href="#" class="close">&times;</a>
            <img src="<%= image.url %>" alt="<%= image.title %>">
        </div>
    <% }); %>
      
</section>

<footer>
    <p>&copy; 2025. Web Programiranje</p>
</footer>

</body>
</html>